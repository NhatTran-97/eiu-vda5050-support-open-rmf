{
  "name": "eiu-delivery-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "vite --mode backend",
    "dev:lan": "vite --mode backend --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
