<?xml version="1.0"?>
<package format="3">
  <name>fleet_bringup</name>
  <version>1.0.0</version>
  <description>Bundled launch for the fleet-management side (RMF core, VDA5050 fleet adapter, mock workcells, UI)</description>
  <maintainer email="nhat.tranduy1997@gmail.com">NhatTran</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rmf_traffic_ros2</exec_depend>
  <exec_depend>rmf_task_ros2</exec_depend>
  <exec_depend>vda5050_fleet_adapter_full_control</exec_depend>
  <exec_depend>eiu_fleet_ui</exec_depend>

  <buildtool_depend>ament_python</buildtool_depend>
  <export><build_type>ament_python</build_type></export>
</package>
